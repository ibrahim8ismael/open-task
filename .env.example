# Open-Task v1 (TS-only, no Python, no AI)
DATABASE_URL=postgresql://open:open@localhost:5432/opentask
POSTGRES_USER=open
POSTGRES_PASSWORD=open
POSTGRES_DB=opentask

SESSION_SECRET=change-me-in-prod-min-32-chars
WEB_BASE_URL=http://localhost:3000

# Superadmin bootstrap (comma-separated emails; ADMIN_INITIAL_PASSWORD >= 12 chars creates missing accounts)
ADMIN_EMAILS=
ADMIN_INITIAL_PASSWORD=

# Frontend -> backend contract
VITE_API_BASE_URL=http://localhost:4040
VITE_WEB_BASE_URL=http://localhost:3000
# parked v1 (leave empty):
# VITE_ADMIN_BASE_URL=
# VITE_SPACE_BASE_URL=
# VITE_LIVE_BASE_URL=

# Backend
PORT=4040
API_KEY_RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=30/minute
NODE_ENV=development
# Cookie `Secure` flag. Empty = auto: secure only when WEB_BASE_URL is https://
# (fixes docker-compose http login loop). Override with 1 to force secure, 0 to force none.
COOKIE_SECURE=

# All-in-one container (docker compose -f docker-compose.allinone.yml up -d --build):
# web on :3000, API on :4040; postgres data + uploads + exports live in the
# `open-task-data` volume. VITE_* values above are baked in at image build time.

# Email (Nodemailer; magic codes, resets, invites, notification digests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Files
UPLOAD_PROVIDER=local
FILE_SIZE_LIMIT=5242880
# S3 reserved for later:
# S3_ENDPOINT=
# S3_BUCKET=uploads
# S3_KEY=
# S3_SECRET=
